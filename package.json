{
  "name": "ugula-monorepo",
  "private": true,
  "type": "module",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.11.1",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.10.1",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r --parallel run build",
    "typecheck": "tsc --noEmit && pnpm -r --parallel run typecheck",
    "test": "node --test libs/*.test.ts && pnpm -r --parallel run test",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "db:migrate": "tsx --env-file=.env .migrations/migrate.ts",
    "db:seed": "tsx --env-file=.env .seeds/seed.ts",
    "seed:check": "tsx .seeds/check.ts",
    "db:reset": "tsx --env-file=.env .seeds/reset.ts",
    "db:ui": "docker compose --profile tools up -d pgweb"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1169.0",
    "@hono/node-server": "2.1.8",
    "@hono/standard-validator": "0.4.1",
    "@ugula/access": "workspace:*",
    "@ugula/auth": "workspace:*",
    "@ugula/billing": "workspace:*",
    "@ugula/catalog": "workspace:*",
    "@ugula/config": "workspace:*",
    "@ugula/db": "workspace:*",
    "@ugula/graph": "workspace:*",
    "@ugula/inference": "workspace:*",
    "@ugula/nemsis": "workspace:*",
    "@xyflow/react": "13.0.0",
    "fast-xml-parser": "5.12.1",
    "hono": "4.13.19",
    "ioredis": "6.0.0",
    "kysely": "0.29.9",
    "lucide-react": "1.73.0",
    "pdf-lib": "1.17.1",
    "pg": "8.23.1",
    "pg-boss": "12.38.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ssh2": "1.17.0",
    "undici": "8.12.4",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@happy-dom/global-registrator": "21.0.4",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ssh2": "1.15.6",
    "@vitejs/plugin-react": "6.3.0",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
