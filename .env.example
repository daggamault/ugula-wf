NODE_ENV=development

# Services: compose.yml starts each one; the apps connect with the same names.

# Postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=ugula
DB_PASSWORD=change-me
DB_NAME=ugula
# Template that pnpm db:reset clones (schema and reference data); defaults to <DB_NAME>_reference.
# DB_REFERENCE_NAME=ugula_reference
# Database browser (pgweb): pnpm db:ui opens it at http://localhost:<DB_UI_PORT>.
DB_UI_PORT=8090

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me

# S3-compatible storage (RustFS)
S3_ENDPOINT=http://localhost:9000
S3_PORT=9000
S3_CONSOLE_PORT=9001
S3_REGION=us-east-1
S3_BUCKET=ugula
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me

# Import SFTP server (SFTPGo): agencies upload NEMSIS files here; the api authenticates and receives them.
SFTP_PORT=2022
SFTP_S3_ENDPOINT=http://rustfs:9000
SFTP_HOME_ROOT=/srv/sftpgo/data
SFTP_HOOK_SECRET=change-me-to-a-random-secret-of-32-plus-characters
SFTP_ADMIN_PORT=8085
SFTP_ADMIN_USERNAME=admin
SFTP_ADMIN_PASSWORD=change-me

# Embeddings (text-embeddings-inference)
EMBEDDINGS_URL=http://localhost:8080
EMBEDDINGS_PORT=8080
EMBEDDINGS_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDINGS_REVISION=97b0c614be4d77ee51c0cef4e5f07c00f9eb65b3

# Completions (llama.cpp)
COMPLETIONS_URL=http://localhost:8081
COMPLETIONS_PORT=8081
COMPLETIONS_MODEL=Qwen3.5-4B-Q4_K_M
COMPLETIONS_MODEL_URL=https://huggingface.co/unsloth/Qwen3.5-4B-GGUF/resolve/e87f176479d0855a907a41277aca2f8ee7a09523/Qwen3.5-4B-Q4_K_M.gguf
# Requests at once (keep equal to WORKER_COMPLETIONS_CONCURRENCY) and the context they share. A request needs
# about 5k tokens at most (a 12,000-character narrative, the prompt and 1,200 tokens of answer), so 8k per slot.
COMPLETIONS_SLOTS=2
COMPLETIONS_CTX_SIZE=16384
# Lighter for a small GPU (about 1.3 GB, less accurate on narratives):
# COMPLETIONS_MODEL=Qwen3.5-2B-Q4_K_M
# COMPLETIONS_MODEL_URL=https://huggingface.co/unsloth/Qwen3.5-2B-GGUF/resolve/f6d5376be1edb4d416d56da11e5397a961aca8ae/Qwen3.5-2B-Q4_K_M.gguf
# Stronger for test and production on a 12 GB+ GPU:
# COMPLETIONS_MODEL=Qwen3.5-9B-Q4_K_M
# COMPLETIONS_MODEL_URL=https://huggingface.co/unsloth/Qwen3.5-9B-GGUF/resolve/3885219b6810b007914f3a7950a8d1b469d598a5/Qwen3.5-9B-Q4_K_M.gguf

# Clearinghouse: the default connection the worker uses for agencies without their own (Settings).
# These values point at the mock (apps/chouse), which serves the same host, port and credentials.
CLEARINGHOUSE_SFTP_HOST=localhost
CLEARINGHOUSE_SFTP_PORT=2223
CLEARINGHOUSE_SFTP_USERNAME=ugula
CLEARINGHOUSE_SFTP_PASSWORD=change-me-clearinghouse
# SHA256 fingerprint of the SFTP server's host key, required with a host; the worker refuses any other key.
# This is the mock's fixed key; ask your clearinghouse for theirs (ssh-keyscan -p 22 host | ssh-keygen -lf -).
CLEARINGHOUSE_SFTP_HOST_KEY=SHA256:VM159e2IEtdtiYxUoqIC5u7Z7D57F/k83MgfOvFrDdM
# Paths on the SFTP server. Waystar uses a write-only /upload and one /download folder.
CLEARINGHOUSE_UPLOAD_PATH=/upload
CLEARINGHOUSE_DOWNLOAD_PATHS=/download
# Batch file extensions: 837P (.CLP), 270 (.ELG) and 276 (.CLS, assumed) for Waystar.
CLEARINGHOUSE_CLAIM_EXTENSION=.CLP
CLEARINGHOUSE_ELIGIBILITY_EXTENSION=.ELG
CLEARINGHOUSE_STATUS_EXTENSION=.CLS
# delete or keep response files on the server after downloading them.
CLEARINGHOUSE_AFTER_DOWNLOAD=delete
CLEARINGHOUSE_POLL_MINUTES=1
# CAQH CORE real-time endpoint for 270/271 and 276/277 (same username and password); empty sends batch files only.
CLEARINGHOUSE_REALTIME_URL=http://localhost:2224/core/realtime
CLEARINGHOUSE_REALTIME_TIMEOUT_SECONDS=30
# Encrypts agencies' clearinghouse passwords; read by the api and worker. 32 random bytes, base64
# (openssl rand -base64 32). Dev value only.
CLEARINGHOUSE_SECRET_KEY=ZGV2LW9ubHktY2xlYXJpbmdob3VzZS1rZXktMzJieXQ=
# Keys to rotate away from, comma separated: passwords sealed with them still open, and the worker seals them
# again with CLEARINGHOUSE_SECRET_KEY on its next poll. Remove a key once the worker has logged every agency.
CLEARINGHOUSE_PREVIOUS_SECRET_KEYS=

# Apps

# Web
WEB_URL=http://localhost:3000
WEB_PORT=3000

# API
API_URL=http://localhost:3001
API_PORT=3001
API_CORS_ORIGINS=http://localhost:3000
API_DB_POOL_MAX=20
API_MAX_BODY_BYTES=10485760
API_MAX_IMPORT_BYTES=104857600

# SSE
SSE_URL=http://localhost:3002
SSE_PORT=3002
SSE_CORS_ORIGINS=http://localhost:3000

# Worker
WORKER_RUN_CONCURRENCY=8
WORKER_COMPLETIONS_CONCURRENCY=2
WORKER_MAX_EVENT_LOOP_UTILIZATION=0.9
# Optional memory limits in MB: over one it claims no new runs. Heap defaults to 85% of the V8 limit; RSS has none.
# WORKER_MAX_HEAP_MB=
# WORKER_MAX_RSS_MB=

# Mock clearinghouse (apps/chouse); it serves the CLEARINGHOUSE_SFTP_* settings above.
CHOUSE_REALTIME_PORT=2224
CHOUSE_REMIT_DELAY_SECONDS=20
# Payer IDs with no ERA enrollment (no 835s), comma separated.
CHOUSE_ERA_UNENROLLED=

# Development: the seeded sign-in and agency SFTP account.
DEV_USER_EMAIL=dev@example.com
DEV_USER_PASSWORD=change-me-please
DEV_SFTP_USERNAME=acme-ems
DEV_SFTP_PASSWORD=change-me
