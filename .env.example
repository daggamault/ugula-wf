CLEARINGHOUSE_SFTP_PORT=2223
CLEARINGHOUSE_SFTP_USERNAME=ugula
CLEARINGHOUSE_SFTP_PASSWORD=change-me-clearinghouse
CLEARINGHOUSE_REMIT_DELAY_SECONDS=20
CLEARINGHOUSE_SFTP_HOST=localhost
# Paths on the clearinghouse SFTP server. The mock follows Waystar: a write-only /upload and one /download folder.
CLEARINGHOUSE_UPLOAD_PATH=/upload
CLEARINGHOUSE_DOWNLOAD_PATHS=/download
# Batch file extensions the clearinghouse expects: 837P (.CLP), 270 (.ELG) and 276 (.CLS, assumed) for Waystar.
CLEARINGHOUSE_FILE_EXTENSION=.CLP
CLEARINGHOUSE_ELIGIBILITY_EXTENSION=.ELG
CLEARINGHOUSE_CLAIM_STATUS_EXTENSION=.CLS
# delete or keep response files on the server after downloading them.
CLEARINGHOUSE_AFTER_DOWNLOAD=delete
CLEARINGHOUSE_POLL_MINUTES=1
# CAQH CORE real-time endpoint for 270/271 and 276/277 (same username and password); empty sends batch files only.
CLEARINGHOUSE_REALTIME_URL=http://localhost:2224/core/realtime
CLEARINGHOUSE_REALTIME_TIMEOUT_SECONDS=30
# The default connection above serves agencies without their own (Settings). Their passwords are encrypted
# with this key, read by the api and worker: 32 random bytes, base64 (openssl rand -base64 32). Dev value only.
CLEARINGHOUSE_SECRET_KEY=ZGV2LW9ubHktY2xlYXJpbmdob3VzZS1rZXktMzJieXQ=
# Mock only: CORE real-time port, and payer IDs with no ERA enrollment (no 835s).
CLEARINGHOUSE_REALTIME_PORT=2224
CLEARINGHOUSE_ERA_UNENROLLED=
