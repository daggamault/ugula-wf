{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!**/pnpm-lock.yaml", "!**/.claude"]
  },
  "formatter": {
    "indentStyle": "space",
    "lineWidth": 100
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error"
      },
      "style": {
        "noNonNullAssertion": "error",
        "noProcessEnv": "error",
        "useConsistentTypeDefinitions": {
          "level": "error",
          "options": {
            "style": "type"
          }
        },
        "useFilenamingConvention": {
          "level": "error",
          "options": {
            "filenameCases": ["kebab-case"]
          }
        }
      },
      "nursery": {
        "useTailwindSortedClasses": {
          "level": "error",
          "fix": "safe"
        }
      },
      "suspicious": {
        "noConsole": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "apps/*/src/main.ts",
        ".migrations/migrate.ts",
        ".seeds/seed.ts",
        ".e2e/*.e2e.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noProcessEnv": "off"
          }
        }
      }
    },
    {
      "includes": ["libs/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@ugula/*"],
                    "message": "Kernel and infrastructure libs import no other libs."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["libs/billing/**", "libs/nemsis/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@ugula/*", "!@ugula/graph", "!@ugula/graph/*"],
                    "message": "Domain libs build only on the graph kernel."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["libs/db/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@ugula/*", "!@ugula/billing", "!@ugula/billing/*"],
                    "message": "The database schema imports only the domain types it stores."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["libs/catalog/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@ugula/*",
                      "!@ugula/graph",
                      "!@ugula/graph/*",
                      "!@ugula/nemsis",
                      "!@ugula/nemsis/*",
                      "!@ugula/billing",
                      "!@ugula/billing/*"
                    ],
                    "message": "The catalog composes the graph kernel and domain libs only."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/*/src/features/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["../**", "!../../shared", "!../../shared/**"],
                    "message": "Features never import sibling features; promote shared code to shared/."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "javascript": {
    "formatter": {
      "trailingCommas": "none",
      "quoteStyle": "single"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
