SFTP_PORT=2022
IMPORT_FILE_MAX_BYTES=104857600
SFTP_S3_ENDPOINT=http://rustfs:9000
SFTP_HOME_ROOT=/srv/sftpgo/data
SFTP_HOOK_SECRET=change-me-to-a-random-secret-of-32-plus-characters
SFTPGO_ADMIN_USERNAME=admin
SFTPGO_ADMIN_PASSWORD=change-me
SFTPGO_ADMIN_PORT=8085

DEV_USER_EMAIL=dev@example.com
DEV_USER_PASSWORD=change-me-please
